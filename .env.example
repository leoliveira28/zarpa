# Banco (Neon em produção — use o endpoint -pooler)
DATABASE_URL=
TEST_DATABASE_URL=
# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Criptografia de dados sensíveis (AES-256-GCM, base64 de 32 bytes)
ENCRYPTION_KEY_V1=
# Cobrança
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_ENV=sandbox
# Integrações de fornecedor (S12 — cotação só). Conta por agente: a chave da
# conta de cada agente vive encriptada na tabela `integrations` (AES-256-GCM),
# lida e decriptada dentro de withTenant. As URLs abaixo são do PRODUTO; as
# API keys do env só servem de fallback/documento — o adapter usa a credencial
# do banco, não a do env.
WOOBA_API_URL=https://api.wooba.com.br
WOOBA_API_KEY=
INFOTRAVEL_API_URL=https://api.infotravel.com.br
INFOTRAVEL_API_KEY=
# E-mail
RESEND_API_KEY=
# Cron (token de máquina para /api/cron/*)
CRON_SECRET=
# Observabilidade
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
# Arquivos
BLOB_READ_WRITE_TOKEN=
APP_NAME=
